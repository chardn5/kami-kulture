// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * -------------------- NEW --------------------
 */
model Customer {
  id        String   @id @default(cuid())
  email     String   @unique
  firstName String?
  lastName  String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([email])
}

model OrderItem {
  id       String @id @default(cuid())
  orderSeq BigInt
  order    Order  @relation(fields: [orderSeq], references: [seq], onDelete: Cascade)

  sku       String
  title     String
  size      String?
  unitPrice Decimal @db.Decimal(12, 2)
  qty       Int
  image     String?

  createdAt DateTime @default(now())

  @@index([orderSeq])
}

/**
 * ---------------- EXISTING (with additions) ----------------
 */
model Order {
  seq       BigInt   @id @default(autoincrement())
  id        String   @unique // your public order id / number
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status      String
  amountTotal Decimal @db.Decimal(12, 2)
  currency    String  @default("USD")

  payerEmail String?
  payerName  String?
  captureId  String?

  productTitle String?
  productSlug  String?
  selectedSize String?
  sku          String?

  raw        Json?
  buyerEmail String?
  // Shipping / customer snapshot (add these)
  shipFirstName  String?
  shipLastName   String?
  shipEmail      String?
  shipPhone      String?
  shipAddress1   String?
  shipAddress2   String?
  shipCity       String?
  shipState      String?
  shipPostalCode String?
  shipCountry    String?
  /**
   * ---- NEW RELATION FIELDS ----
   */
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  items       OrderItem[]
  fulfilledAt DateTime?

  /**
   * ---- OPTIONAL MONEY BREAKOUTS (use later) ----
   */
  amountSubtotal Decimal? @db.Decimal(12, 2)
  amountShipping Decimal? @db.Decimal(12, 2)
  amountTax      Decimal? @db.Decimal(12, 2)

  @@index([createdAt])
  @@index([status])
  @@index([payerEmail])
  @@index([productSlug])
  @@index([customerId])
  @@index([captureId])
}

/// ===== Printify-synced catalog =====
model Product {
  id           String   @id @default(cuid())
  /// Printify product id (string UUID-ish)
  printifyId   String   @unique
  title        String
  slug         String   @unique
  description  String?
  visible      Boolean  @default(true)
  tags         String[] @default([])

  /// Derived convenience fields
  priceMinCents Int     @default(0)
  priceMaxCents Int     @default(0)
  currency      String  @default("USD")

  /// Optional raw options snapshot from Printify (Color/Size lists)
  optionsJson  Json?

  /// Timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Printify timestamps (keep as strings from API)
  srcCreatedAt String?
  srcUpdatedAt String?

  images   ProductImage[]
  variants ProductVariant[]

  @@index([slug])
  @@index([title])
  @@index([printifyId])
}

model ProductImage {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url        String
  position   Int     @default(0)
  /// Some images are tied to variants (e.g., color mockups)
  variantIds Int[]

  createdAt  DateTime @default(now())

  @@index([productId])
}

model ProductVariant {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Printify variant id (numeric) for ordering/fulfillment
  variantId   Int
  sku         String  @default("")
  title       String  // e.g., "Black / L"
  /// Store both raw and denormalized values
  optionIndexes Int[] // indexes into optionsJson values
  color       String?
  size        String?

  priceCents  Int
  isEnabled   Boolean  @default(true)
  isAvailable Boolean  @default(true)
  grams       Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId, variantId]) // one Printify variant per product
  @@index([productId])
  @@index([sku])
}
